      "panels": [],
      "title": "Device Availability Timeline",
      "type": "row"
    },
    {
      "id": 2,
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 1 },
      "type": "state-timeline",
      "title": "Device Type Availability Timeline - $store",
      "datasource": { "type": "prometheus", "uid": "prometheus-posproctor2" },
      "description": "Shows availability status of all device types for the selected store over time. Green = Online, Red = Offline. Use the $store filter at the top to select a specific store. FP = Fueling Point.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (store) (posproctor_controller_status{store=~\"$store\"})",
          "legendFormat": "Controller"
        },
        {
          "refId": "B",
          "expr": "max by (store, fueling_point_id) (posproctor_pump_status{store=~\"$store\"})",
          "legendFormat": "Pump FP-{{fueling_point_id}}"
        },
        {
          "refId": "C",
          "expr": "max by (store, fueling_point_id) (posproctor_dcr_status{store=~\"$store\"})",
          "legendFormat": "DCR FP-{{fueling_point_id}}"
        },
        {
          "refId": "D",
          "expr": "max by (store, display_id) (posproctor_price_display_status{store=~\"$store\"})",
          "legendFormat": "Fuel Sign {{display_id}}"
        },
        {
          "refId": "E",
          "expr": "max by (store) (posproctor_primary_fep_status{store=~\"$store\"})",
          "legendFormat": "Card Processor"
        },
        {
          "refId": "F",
          "expr": "max by (store) (posproctor_loyalty_fep_status{store=~\"$store\"})",
          "legendFormat": "Loyalty FEP"
        },
        {
          "refId": "G",
          "expr": "max by (store, terminal_id) (posproctor_pos_terminal_status{store=~\"$store\"})",
          "legendFormat": "POS Terminal {{terminal_id}}"
        },
        {
          "refId": "H",
          "expr": "max by (store, pinpad_id) (posproctor_pinpad_status{store=~\"$store\"})",
          "legendFormat": "Pinpad {{pinpad_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 100,
            "spanNulls": false,
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red"
                },
                "1": {
                  "text": "Online",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 0.5,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
