# POSProctor 2.0 Environment Configuration

# ============================================
# Database Configuration
# ============================================
POSPROCTOR_DB_PATH=/app/data/database/posproctor.db

# ============================================
# Verifone Commander Credentials
# ============================================
COMMANDER_USERNAME=admin
COMMANDER_PASSWORD=your-password-here

# ============================================
# TLOG Service Configuration
# ============================================
TLOG_API_KEY=your-secure-api-key-here
TLOG_RETENTION_DAYS=90
TLOG_STORAGE_PATH=/app/data/tlogs

# ============================================
# Web UI Authentication
# ============================================
FLASK_SECRET_KEY=your-random-secret-key-here

# Authentication: 'none' (no auth) or 'entra' (Azure AD SSO)
AUTH_TYPE=none

# Azure AD / Entra SSO (only used when AUTH_TYPE=entra)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI=

# ============================================
# SMTP / Email Configuration
# ============================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=POSProctor Alert System
ALERT_EMAIL=alerts@your-company.com

# ============================================
# Grafana Configuration
# ============================================
GRAFANA_ADMIN_PASSWORD=admin123

# ============================================
# Monitoring Configuration
# ============================================
# Polling interval in seconds
POLL_INTERVAL=300
# Number of worker threads
WORKER_THREADS=10
# Request timeout in seconds
REQUEST_TIMEOUT=30

# XML Debug Storage
XML_DEBUG_ENABLED=false
XML_DEBUG_RETENTION_MINUTES=60
XML_DEBUG_PATH=/app/data/xml_debug

# ============================================
# Bitwarden Configuration (Password Manager)
# ============================================
BW_CLIENTID=
BW_CLIENTSECRET=
BW_PASSWORD=
BW_SERVER=https://vault.bitwarden.com

# ============================================
# Development Mode
# ============================================
DEV_MODE=false
DEV_STORE_FILTER=
